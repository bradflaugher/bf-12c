<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all: no network, no storage, nothing leaves the device. -->

    <!-- Touch is optional: a Chromebook or desktop with only a keyboard and
         mouse (or trackpad) can install it and use every key. Without this, Play
         assumes a touchscreen is required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Not a permission: lets Share app check that something can take plain text
         before it opens the share sheet. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- hasFragileUserData: uninstalling offers to keep the stack, registers and program on the device. -->
    <application
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Bf12c">

        <!-- Compose handles every configuration change in place: rotating, folding,
             resizing a desktop window, moving it to another display or plugging in a
             keyboard never restarts the activity. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation|fontScale|fontWeightAdjustment|layoutDirection|locale|colorMode|touchscreen"
            android:exported="true">
            <!-- Below this, a freeform or split-screen window can't fit a usable keyboard. -->
            <layout
                android:minWidth="320dp"
                android:minHeight="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
